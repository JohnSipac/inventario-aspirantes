<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.johnlab.inventarysystem.controller.RegistroController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <AnchorPane prefHeight="75.0" prefWidth="580.0" styleClass="banner" stylesheets="@../css/styles.css" BorderPane.alignment="CENTER">
               <children>
                  <Label alignment="CENTER" layoutX="130.0" layoutY="19.0" maxWidth="1.7976931348623157E308" text="Registro" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
               </children>
            </AnchorPane>
         </top>
         <left>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
         </left>
         <center>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" stylesheets="@../css/styles.css" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" text="Datos de registro" />
                        <Label text="Rol" />
                        <TextField fx:id="txtRol" promptText="1: Usuario, 2: Administrador" />
                        <Label text="Nombre" />
                        <TextField fx:id="txtNombre" promptText="ej. Roberto" />
                        <Label text="Apellido" />
                        <TextField fx:id="txtApellido" promptText="ej. Pérez" />
                        <Label text="Correo" />
                        <TextField fx:id="txtCorreo" promptText="ej. robertoperez@gmail.com" />
                        <Label text="Contraseña" />
                        <PasswordField fx:id="psContrasena" promptText="*******************" />
                        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#handleRegistrarUsuario" prefHeight="25.0" prefWidth="86.0" text="Guardar" />
                              <Button mnemonicParsing="false" onAction="#handleCancelar" prefHeight="25.0" prefWidth="78.0" text="Cancelar" />
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                  </VBox>
               </children>
            </AnchorPane>
         </center>
         <bottom>
            <AnchorPane prefHeight="11.0" prefWidth="580.0" styleClass="banner" stylesheets="@../css/styles.css" BorderPane.alignment="CENTER" />
         </bottom>
         <right>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
         </right>
      </BorderPane>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
